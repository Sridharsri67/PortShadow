# PortShadow Server Environment Configuration

# Server Port (Default: 5005 to avoid macOS AirPlay conflict on 5000)
PORT=0000

# Allowed Client Origin for CORS and WebSockets
CLIENT_URL=http://localhost:0000

# Managed PostgreSQL Database URL (Neon DB)
DATABASE_URL="postgresql://neondb_owner:npg_secret@ep-cool-sample-a5xyz.us-east-2.aws.neon.tech/portshadow?sslmode=require"
